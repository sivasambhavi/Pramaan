# ═══════════════════════════════════════════════════════════════════════════════
# PRAMAAN — Environment Configuration Example
# -------------------------------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp env.example .env
#
# Never commit .env to git — it is in .gitignore
# ═══════════════════════════════════════════════════════════════════════════════


# ── App ────────────────────────────────────────────────────────────────────────
PRAMAAN_ENV=development          # development | staging | production
API_BASE_URL=http://localhost:8000


# ── Neo4j ──────────────────────────────────────────────────────────────────────
# Local install : bolt://localhost:7687
# AuraDB (cloud): neo4j+s://<instance>.databases.neo4j.io
# Download      : https://neo4j.com/download/
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme


# ── LLM — Primary: Groq ───────────────────────────────────────────────────────
# Used by : fetch_unstructured.py, ai_service.py, scheduler.py
# Models  : llama-3.1-8b-instant (pipeline) / llama-3.3-70b-versatile (backend)
# Free tier: 500,000 tokens/day — auto-falls back to Gemini when quota hit
# Get key : https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_your_groq_key_here


# ── LLM — Fallback: Google Gemini ─────────────────────────────────────────────
# Used by : fetch_unstructured.py, ai_service.py (auto-switches when Groq hits 429)
# Model   : gemini-1.5-flash
# Free tier: 1,500 requests/day, 1M tokens/min — generous fallback
# Get key : https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_key_here


# ── data.gov.in API ────────────────────────────────────────────────────────────
# Used by : fetch_govdata.py (fetches AMRUT, PMAY, SBM, SVANidhi datasets)
# Datasets: see config/pipeline_config.yaml → govdata_sources for all UUIDs
# Get key : https://data.gov.in/user/register → My Account → API Keys → Generate
DATA_GOV_API_KEY=your_datagov_key_here


# ── Twilio (WhatsApp / SMS notifications) ─────────────────────────────────────
# Used by : backend/app/routers/notifications.py
# Get creds: https://console.twilio.com → Account Info
# Sandbox  : https://console.twilio.com → Messaging → WhatsApp Sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=whatsapp:+14155238886
